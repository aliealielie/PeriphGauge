<Window x:Class="WirelessBattery.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量悬浮窗" Width="192" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#FFFFFF"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DeviceVisuals.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelControl" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#252525" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#3E3E3E" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Surface" Margin="8" Background="#000000" BorderBrush="#1E1E1E" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="26" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=ExpandedView}" Value="Visible">
                        <Setter Property="CornerRadius" Value="22" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="13" ShadowDepth="2" Opacity="0.72" />
        </Border.Effect>
        <Grid>
            <Button x:Name="CompactView" Height="50" Cursor="Hand"
                    Click="ExpandClick" PreviewMouseLeftButtonDown="CompactMouseDown"
                    ToolTip="单击展开 · 拖动可移动" AutomationProperties.Name="展开设备电量"
                    AutomationProperties.HelpText="单击展开。也可以按住拖动悬浮窗。"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="25">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="#0A0A0A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hit" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid Margin="4,0">
                    <ItemsControl x:Name="CompactItems" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding Description}"
                                            AutomationProperties.Name="{Binding Description}">
                                    <ContentControl Template="{StaticResource DeviceRing}" Focusable="False"
                                                    Width="39" Height="39"
                                                    Margin="0,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Battery}" Foreground="{Binding BatteryTone}"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Visibility, ElementName=CompactStatus}">
                        <Path Data="M 8,1 L 2,8 L 7,8 L 5,14 L 12,6 L 7,6 Z" Fill="#FFFFFF"
                              Width="12" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="CompactStatus" Text="正在读取电量…" Foreground="#ADADAD"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
            <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="15,8,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Background="Transparent" MinHeight="25" MouseLeftButtonDown="DragHandleClick" Cursor="SizeAll"
                      ToolTip="按住拖动悬浮窗">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备电量" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="DeviceCount" Grid.Column="1" Foreground="#A6A6A6" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Button x:Name="CollapseButton" Grid.Column="2" Style="{StaticResource PanelControl}" ToolTip="收起面板"
                            AutomationProperties.Name="收起面板" Click="CollapseClick">
                        <Path Data="M 1,6 L 4,3 L 7,6" Stroke="#A6A6A6" StrokeThickness="1.15"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource PanelControl}" ToolTip="隐藏悬浮窗"
                            AutomationProperties.Name="隐藏悬浮窗" Click="HideClick">
                        <Path Data="M 2,2 L 8,8 M 8,2 L 2,8" Stroke="#A6A6A6" StrokeThickness="1.15"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" />
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="Status" Margin="0,9,0,6" Text="正在读取电量…"
                           Foreground="#ADADAD" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                <ScrollViewer Grid.Row="1" x:Name="DeviceScroll" Margin="0,3,0,0" MaxHeight="192"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed" AutomationProperties.Name="无线设备电量">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DeviceScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="DeviceItems" PreviewMouseLeftButtonDown="DragHandleClick">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="47" ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Divider" Grid.ColumnSpan="3" Height="1" Background="#353535"
                                            VerticalAlignment="Top" Visibility="Collapsed" />
                                    <ContentControl Template="{StaticResource DeviceRing}" Focusable="False"
                                                    Width="41" Height="41"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="6,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Path x:Name="ConnectionGlyph" Data="{StaticResource GlyphReceiver}" Width="11" Height="12" Stretch="Uniform"
                                                  Stroke="#B5B5B5" StrokeThickness="1.25" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Connection}" Foreground="#B5B5B5" FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Battery}" Foreground="{Binding BatteryTone}"
                                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" AutomationProperties.Name="{Binding BatteryLabel}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasDivider}" Value="True">
                                        <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connection}" Value="蓝牙">
                                        <Setter TargetName="ConnectionGlyph" Property="Data" Value="{StaticResource GlyphBluetooth}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
