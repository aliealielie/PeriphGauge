<Window x:Class="WirelessBattery.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量悬浮窗" Width="246" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#F1F6F5"
        KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="#182126" BorderBrush="#39464B" BorderThickness="1"
            CornerRadius="13" Margin="8" MouseLeftButtonDown="DragHandleClick">
        <Border.Effect>
            <DropShadowEffect Color="#071011" BlurRadius="12" ShadowDepth="2" Opacity="0.6" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="10,6,5,5" Background="Transparent" Cursor="SizeAll" ToolTip="按住拖动悬浮窗">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border Background="#93E9C5" CornerRadius="5" Width="18" Height="18">
                    <Path Data="M 6,1 L 2,5.5 L 6,5.5 L 4,9.5 L 8.5,4.5 L 4.5,4.5 Z"
                          Fill="#17362C" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="外设电量" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="7,0,0,0" />
                <Path Grid.Column="2" Data="M 2,2 L 2.1,2 M 7,2 L 7.1,2 M 2,6 L 2.1,6 M 7,6 L 7.1,6 M 2,10 L 2.1,10 M 7,10 L 7.1,10"
                      Stroke="#829797" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="3" Width="24" Height="24" Cursor="Hand"
                        ToolTip="隐藏悬浮窗" AutomationProperties.Name="隐藏悬浮窗" AutomationProperties.AcceleratorKey="Esc" Click="HideClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Hit" Background="Transparent" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="#B6C5C8"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hit" Property="Background" Value="#2D3E42" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Hit" Property="Background" Value="#394B4F" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Hit" Property="BorderBrush" Value="#93E9C5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Border Height="1" Background="#334147" Margin="10,0,10,0" />
            <TextBlock x:Name="Status" Margin="11,8,11,10" Text="正在读取电量…"
                       Foreground="#A9B7BD" FontSize="11.5" AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer x:Name="DeviceScroll" Margin="10,4,8,6" MaxHeight="184"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed" AutomationProperties.Name="无线设备电量">
                <ScrollViewer.Resources>
                    <Style x:Key="TrackSpace" TargetType="RepeatButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="#26353B" CornerRadius="4" Margin="1,1,0,1">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource TrackSpace}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#5B7679" CornerRadius="4"
                                                                    x:Name="Handle" MinHeight="18" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Handle" Property="Background" Value="#849EA0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource TrackSpace}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="DeviceItems" PreviewMouseLeftButtonDown="DragHandleClick">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="25" Margin="0,0,2,0" ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="1,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Connection}" Foreground="{Binding ConnectionTone}"
                                           FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Battery}" Foreground="{Binding BatteryTone}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" AutomationProperties.Name="{Binding BatteryLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
