<Window x:Class="WirelessBattery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量" Width="388" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#FFFFFF"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DeviceVisuals.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="MutedText" Color="#ADADAD" />
            <SolidColorBrush x:Key="PanelHighlight" Color="#FFFFFF" />
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Foreground" Value="#D0D0D0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#252525" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#3E3E3E" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PanelHighlight}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OptionsMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBackground" Background="Transparent" CornerRadius="6" Padding="8,7,12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Checkmark" Data="M 1,5 L 4,8 L 9,2" Stroke="{StaticResource PanelHighlight}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Visibility="Hidden" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="#282828" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="BatteryRow">
                <Grid MinHeight="64" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="RowDivider" Grid.ColumnSpan="3" Height="1" Background="#343434" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <ContentControl Template="{StaticResource DeviceRing}" Focusable="False"
                                    Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Battery}" Foreground="{Binding BatteryTone}" FontSize="23"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding BatteryLabel}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ConnectionGroup">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="3,2,0,8">
                        <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="#E8E8E8" StrokeThickness="1.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Foreground="#F0F0F0" FontSize="13"
                                   FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <Border Background="#232323" CornerRadius="12" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BatteryRow}" />
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="12" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="19" ShadowDepth="3" Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,19,15,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border Width="43" Height="43" Background="#292929" CornerRadius="13">
                    <Path Data="M 8,1 L 2,8 L 7,8 L 5,14 L 12,6 L 7,6 Z" Fill="{StaticResource PanelHighlight}"
                          Width="20" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,5,0" VerticalAlignment="Center">
                    <TextBlock Text="外设电量" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="Summary" Text="正在扫描无线设备…" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}"
                        ToolTip="刷新电量" AutomationProperties.Name="刷新电量" Click="RefreshClick">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Data="M 13.5,6 A 5.25,5.25 0 1 0 13.5,10 M 13.5,3.3 L 13.5,6.2 L 10.6,6.2" />
                </Button>
                <Button x:Name="OptionsButton" Grid.Column="3" Style="{StaticResource IconButton}"
                        ToolTip="更多选项" AutomationProperties.Name="更多选项" Click="OptionsClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OptionsMenu" Placement="Bottom" VerticalOffset="4"
                                     FontFamily="Segoe UI, Microsoft YaHei UI" Closed="OptionsClosed"
                                     AutomationProperties.Name="更多选项">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="#191919" BorderBrush="#454545" BorderThickness="1"
                                            CornerRadius="11" Padding="5" MinWidth="160">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <MenuItem x:Name="WidgetOption" Header="显示桌面悬浮窗" IsCheckable="True"
                                      Style="{StaticResource OptionsMenuItem}" Checked="WidgetChanged" Unchecked="WidgetChanged" />
                            <MenuItem x:Name="TopmostOption" Header="悬浮窗置顶" IsCheckable="True"
                                      Style="{StaticResource OptionsMenuItem}" Checked="TopmostChanged" Unchecked="TopmostChanged" />
                            <MenuItem x:Name="StartupOption" Header="开机自启动" IsCheckable="True"
                                      Style="{StaticResource OptionsMenuItem}" Checked="StartupChanged" Unchecked="StartupChanged" />
                            <MenuItem Header="创建桌面快捷方式" Style="{StaticResource OptionsMenuItem}"
                                      Click="DesktopShortcutClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 1,3 A 1.1,1.1 0 1 1 3.2,3 A 1.1,1.1 0 1 1 1,3 Z M 6,3 A 1.1,1.1 0 1 1 8.2,3 A 1.1,1.1 0 1 1 6,3 Z M 11,3 A 1.1,1.1 0 1 1 13.2,3 A 1.1,1.1 0 1 1 11,3 Z" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="隐藏面板"
                        AutomationProperties.Name="隐藏面板" Click="HideClick">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 3,3 L 12,12 M 12,3 L 3,12" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <ScrollViewer x:Name="DeviceScroll" MaxHeight="375" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                              AutomationProperties.Name="无线设备列表">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DeviceScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="DeviceItems" ItemTemplate="{StaticResource ConnectionGroup}" />
                </ScrollViewer>
                <Border x:Name="Placeholder" BorderBrush="#2F2F2F" BorderThickness="1" Background="#171717"
                        CornerRadius="14" Padding="14,15" Margin="0,0,0,8" MinHeight="78">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTitle" Text="正在读取电量" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="PlaceholderText" Text="首次扫描可能需要几秒。" Foreground="{StaticResource MutedText}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="19,7,19,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#BFBFBF" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModeText" Text="自动刷新" Foreground="{StaticResource MutedText}"
                               FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="UpdatedText" Foreground="{StaticResource MutedText}" FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
