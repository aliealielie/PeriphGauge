<Window x:Class="WirelessBattery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量" Width="388" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#F1F6F5"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#A9B7BD" />
        <SolidColorBrush x:Key="Mint" Color="#93E9C5" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#B5C3C8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26363B" />
                                <Setter Property="Foreground" Value="#F1F6F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#32474A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Mint}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BatteryBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#344148" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="BatteryRow">
            <Border Background="#20292F" BorderBrush="#303D43" BorderThickness="1"
                    CornerRadius="14" Padding="12,11" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="38" Height="38" Background="#2B393F" CornerRadius="10">
                        <Path Data="{Binding Icon}" Width="21" Height="21" Stretch="Uniform"
                              Stroke="#C6D9D6" StrokeThickness="1.45" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,10,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding BatteryLabel}">
                        <TextBlock Text="{Binding Number}" Foreground="{Binding Tone}" FontSize="26"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Unit}" Foreground="{Binding Tone}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,4,0,0" />
                    </StackPanel>
                    <ProgressBar x:Name="Meter" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                 Value="{Binding Value, Mode=OneWay}" Maximum="100" Foreground="{Binding Tone}"
                                 Style="{StaticResource BatteryBar}" AutomationProperties.Name="{Binding BatteryLabel}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasBattery}" Value="False">
                    <Setter TargetName="Meter" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ConnectionGroup">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,2,0,8">
                    <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Tone}" StrokeThickness="1.35" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Foreground="{Binding Tone}" FontSize="12"
                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BatteryRow}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border Margin="12" BorderBrush="#39464B" BorderThickness="1" CornerRadius="22">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.25,1">
                <GradientStop Offset="0" Color="#1D292D" />
                <GradientStop Offset="0.46" Color="#161E23" />
                <GradientStop Offset="1" Color="#151D22" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#071011" BlurRadius="19" ShadowDepth="3" Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,19,15,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border Width="43" Height="43" CornerRadius="13">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#B0F5D7" />
                            <GradientStop Offset="1" Color="#73DDB4" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M 2,7 Q 2,5 4,5 L 17,5 Q 19,5 19,7 L 19,15 Q 19,17 17,17 L 4,17 Q 2,17 2,15 Z M 21,9 L 21,13 M 11,7.5 L 8,11 L 12,11 L 10,14.5"
                          Stroke="#15342B" StrokeThickness="1.55" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,5,0" VerticalAlignment="Center">
                    <TextBlock Text="外设电量" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="Summary" Text="正在扫描无线设备…" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}"
                        ToolTip="刷新电量" AutomationProperties.Name="刷新电量" Click="RefreshClick">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Data="M 13.5,6 A 5.25,5.25 0 1 0 13.5,10 M 13.5,3.3 L 13.5,6.2 L 10.6,6.2" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="隐藏面板"
                        AutomationProperties.Name="隐藏面板" Click="HideClick">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 3,3 L 12,12 M 12,3 L 3,12" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <ScrollViewer x:Name="DeviceScroll" MaxHeight="375" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                              AutomationProperties.Name="无线设备列表">
                    <ItemsControl x:Name="DeviceItems" ItemTemplate="{StaticResource ConnectionGroup}" />
                </ScrollViewer>
                <Border x:Name="Placeholder" BorderBrush="#34434A" BorderThickness="1" Background="#20292F"
                        CornerRadius="14" Padding="14,15" Margin="0,0,0,8" MinHeight="78">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTitle" Text="正在读取电量" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="PlaceholderText" Text="首次扫描可能需要几秒。" Foreground="{StaticResource MutedText}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="19,7,19,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModeText" Text="自动刷新" Foreground="{StaticResource MutedText}"
                               FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="UpdatedText" Foreground="{StaticResource MutedText}" FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
